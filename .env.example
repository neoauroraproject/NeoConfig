# Application
APP_NAME=NeoConfig
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://NeoConfig:NeoConfig@localhost:5432/NeoConfig?schema=public

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeNow!

# Encryption at rest (32-byte hex or base64). Generate: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Agent / installer
AGENT_ENROLLMENT_TTL_MINUTES=30
INSTALL_SHA256_PIN=
INSTALL_SIGNING_PUBLIC_KEY=

# Optional Redis (leave empty to disable)
REDIS_URL=

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
