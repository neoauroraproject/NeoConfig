{
	email {$ACME_EMAIL}
	# Brand domains get certificates on their first visit, but only after the
	# API confirms the domain belongs to a brand.
	on_demand_tls {
		ask http://api:4000/api/v1/public/domain-check
	}
}

(app) {
	encode zstd gzip
	log
	handle /api/v1/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy web:3000
	}
}

# Main domain: the Let's Encrypt certificate is requested as soon as Caddy
# starts, so DNS/port problems show up in `neoconfig logs proxy` right away.
{$PRIMARY_DOMAIN:localhost} {
	import app
}

# Every other HTTPS host: certificate issued on demand (brand domains).
https:// {
	tls {
		on_demand
	}
	import app
}

# Plain HTTP → HTTPS (Let's Encrypt HTTP challenges are answered before this).
http:// {
	redir https://{host}{uri} permanent
}
