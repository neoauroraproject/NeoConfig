# Images (prebuilt on GHCR). Pin a release with e.g. NEOCONFIG_TAG=1.2.0
NEOCONFIG_TAG=latest

# Application
APP_NAME=NeoConfig
NODE_ENV=development
PORT=4000

# Database
# Local default uses host port 5433 (avoids clashes with other Postgres on 5432)
DATABASE_URL=postgresql://neoconfig:neoconfig@localhost:5433/neoconfig?schema=public

# Auth — owner account created on first API start
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BOOTSTRAP_ADMIN_EMAIL=admin@neoconfig.local
BOOTSTRAP_ADMIN_PASSWORD=NeoConfig123!

# Encryption at rest for panel credentials and subscription links.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Domains & SSL
# Main domain of this install (always allowed a certificate, besides brand domains).
PRIMARY_DOMAIN=
# Email Let's Encrypt uses for expiry notices.
ACME_EMAIL=admin@example.com
# This server's public IP; the admin "check DNS" button compares brand domains against it.
PUBLIC_IP=

# Web push (optional). Leave empty and keys are generated once and stored in the database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# How often followed accounts are re-checked for expiry/data reminders (0 turns it off).
PUSH_REMINDER_INTERVAL_MINUTES=360

# Telegram renewal notices use each brand's own bot (set in the admin panel).
# Servers that cannot reach api.telegram.org can point this at a relay.
TELEGRAM_API_BASE=https://api.telegram.org

# Panels on localhost / private networks (LAN installs, local testing).
ALLOW_PRIVATE_PANELS=false

# Web app → API (server side and /api/v1 rewrite). In Docker this is http://api:4000.
API_INTERNAL_URL=http://localhost:4000

# Agent / installer (public URLs baked into the one-line install command)
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
AGENT_ENROLLMENT_TTL_MINUTES=30
INSTALL_SHA256_PIN=
INSTALL_SIGNING_PUBLIC_KEY=

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
