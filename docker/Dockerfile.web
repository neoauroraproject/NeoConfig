FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
COPY apps/web/package.json apps/web/
RUN npm install --workspace=@neoconfig/web --include-workspace-root

FROM node:22-alpine AS build
WORKDIR /app
# Rewrites (/api/v1 -> API) are baked into the build output.
ARG API_INTERNAL_URL=http://api:4000
ENV API_INTERNAL_URL=$API_INTERNAL_URL
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm install --workspace=@neoconfig/web --include-workspace-root \
  && npm run build --workspace=@neoconfig/web

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
COPY scripts/install.sh ./apps/web/public/install.sh
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
