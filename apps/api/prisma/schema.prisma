generator client {
  provider      = "prisma-client-js"
  // Release bundles run on Ubuntu 22.04+ / Debian 12+ (OpenSSL 3), amd64 and arm64.
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  RESELLER
  USER
}

enum RenewalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ServerStatus {
  PENDING
  ONLINE
  OFFLINE
  REVOKED
}

enum SyncState {
  NEVER
  OK
  STALE
  FAILED
}

enum QuotaKind {
  KNOWN
  UNLIMITED
  UNKNOWN
}

enum ExpiryKind {
  KNOWN
  NONE
  UNKNOWN
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  DISABLED
  UNKNOWN
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  brands           Brand[]
  panels           PanelConnection[]
  servers          Server[]
  subscriptions    Subscription[]
  hmpanel          HmPanelConnection?
  auditLogs        AuditLog[]
  enrollmentTokens EnrollmentToken[]
  renewals         RenewalRequest[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(USER)
  orgId        String?
  locale       String   @default("en")
  theme        String   @default("system")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org           Organization?  @relation(fields: [orgId], references: [id], onDelete: SetNull)
  subscriptions Subscription[]
  sessions      Session[]
  auditLogs     AuditLog[]
  ownedBrands   Brand[]        @relation("BrandOwner")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A white-label storefront: its own name, colors, domains, panels and renewal desk.
model Brand {
  id              String  @id @default(cuid())
  orgId           String
  slug            String  @unique
  appName         String  @default("NeoConfig")
  shortName       String  @default("NeoConfig")
  tagline         String?
  logoUrl         String?
  iconUrl         String?
  primaryColor    String  @default("#4F5BD5")
  accentColor     String  @default("#FF6A1A")
  /// mist | graphite | sage | moss | pearl
  theme           String  @default("mist")
  /// local = receipts reviewed in NeoConfig; hmpanel = sent to the HMPanel store (its bot approves)
  renewalVia      String  @default("local")
  /// Only subscriptions found on this brand's own panels can be added (no reading the link itself).
  /// Always on for brands owned by a reseller.
  strictLookup    Boolean @default(false)
  /// New purchases: "store" = an HMPanel store order; "direct" = NeoConfig creates the client on
  /// the brand's HMPanel connection (its admin's quota) on the inbounds below.
  purchaseVia      String  @default("store")
  /// JSON array of HMPanel inbound ids a directly bought service is created on.
  purchaseInbounds String?
  /// NeoUptime status page shown in the app: base URL, page slug, API key (encrypted).
  uptimeUrl        String?
  uptimeSlug       String?
  uptimeKeyEnc     String?
  /// HMPanel connection used for the store, cards and products
  renewalPanelId  String?
  /// Show customers the HMPanel store card (live) instead of the typed one
  cardFromPanel   Boolean @default(false)
  /// Which HMPanel card; empty = the first enabled one
  hmCardId        String?
  /// Keep linked plans' days, data and price in step with HMPanel products
  plansSync       Boolean @default(false)
  /// Customers can buy a new service in the app (through the HMPanel store)
  purchaseEnabled Boolean @default(false)
  /// Decide receipts nobody reviewed after this many minutes (0 = off)
  autoDecideMinutes Int    @default(0)
  /// approve (renew on the panel) | reject
  autoDecideAction  String @default("approve")
  /// Extra themes the customer may switch to in the app menu
  themeChoices    String[] @default([])
  defaultLocale   String  @default("fa")
  supportUrl      String?
  supportTelegram String?
  contactEmail    String?
  allowCopyLink   Boolean @default(true)
  active          Boolean @default(true)
  isDefault       Boolean @default(false)
  ownerId         String?

  renewalEnabled Boolean @default(false)
  cardNumber     String?
  cardHolder     String?
  bankName       String?
  renewalNote    String?
  /// JSON array of { id, title, days, gb, price }
  plansJson      String  @default("[]")

  /// Push a reminder to followers when an account nears expiry or runs low on data.
  expiryRemindersEnabled Boolean @default(true)

  /// Telegram notices for the sales team: new receipts and decisions.
  /// Bot token is AES-GCM encrypted at rest.
  telegramBotTokenEnc   String?
  telegramChatId        String?
  /// Random secret Telegram echoes on webhook calls (inline approve/reject).
  telegramWebhookSecret String?
  /// Uploaded logo (PNG/JPEG/WebP, ≤512 KB), served at /api/v1/public/brands/<slug>/logo
  logoData              Bytes?
  logoMime              String?
  /// Light logo for the dark themes (graphite, sage, moss, pearl)
  logoDarkData    Bytes?
  logoDarkMime    String?
  logoDarkUrl     String?
  /// Brand's own wording for the first screen and the intro (JSON, default locale)
  copyJson        String  @default("{}")
  /// Automatic notifications: thresholds and message texts (JSON, only what differs from the defaults)
  reminderJson    String  @default("{}")
  /// Home-screen icon background: theme | white | black | brand | a gradient preset
  iconBg          String  @default("theme")
  /// Main buttons' color (empty = the primary color)
  buttonColor     String?
  /// Where this brand reaches Telegram from a server that can't: a relay base URL and/or an HTTP proxy
  telegramApiBase String?
  telegramProxy   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org       Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner     User?             @relation("BrandOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  domains   BrandDomain[]
  panels    PanelConnection[]
  renewals  RenewalRequest[]
  devices   PushDevice[]
  lookups   LookupEvent[]
  reminders ExpiryReminder[]

  @@index([orgId])
  appDevices AppDevice[]
  appSubscriptionAdds AppSubscriptionAdd[]
  pushLogs PushLog[]
  customers CustomerAccount[]
}

model BrandDomain {
  id           String    @id @default(cuid())
  brandId      String
  domain       String    @unique
  lastCheckAt  DateTime?
  dnsOk        Boolean?
  sslOk        Boolean?
  checkMessage String?
  createdAt    DateTime  @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

model PanelConnection {
  id              String    @id @default(cuid())
  orgId           String
  name            String
  /// xui (3x-ui / Sanaei) | pasarguard
  type            String    @default("xui")
  baseUrl         String
  /// AES-GCM encrypted API token or password payload (JSON)
  credentialsEnc  String
  authMode        String    @default("bearer")
  webBasePath     String    @default("")
  subPathHint     String?
  lastTestAt      DateTime?
  lastTestOk      Boolean?
  lastTestMessage String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  brands Brand[]
}

model Server {
  id              String       @id @default(cuid())
  orgId           String
  name            String
  hostname        String?
  agentVersion    String?
  status          ServerStatus @default(PENDING)
  credentialHash  String?
  lastHeartbeatAt DateTime?
  panelBaseUrl    String?
  panelCredsEnc   String?
  revokedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  org              Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  enrollmentTokens EnrollmentToken[]
}

model EnrollmentToken {
  id        String    @id @default(cuid())
  orgId     String
  serverId  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  server Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model Subscription {
  id             String   @id @default(cuid())
  orgId          String?
  userId         String
  displayName    String
  color          String?
  /// AES-GCM encrypted subscription URL
  urlEnc         String
  urlFingerprint String
  subIdHint      String?
  panelId        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org      Organization?         @relation(fields: [orgId], references: [id], onDelete: SetNull)
  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshot SubscriptionSnapshot?
}

model SubscriptionSnapshot {
  id             String             @id @default(cuid())
  subscriptionId String             @unique
  status         SubscriptionStatus @default(UNKNOWN)
  uploadBytes    BigInt?
  downloadBytes  BigInt?
  totalUsedBytes BigInt?
  quotaBytes     BigInt?
  remainingBytes BigInt?
  quotaKind      QuotaKind          @default(UNKNOWN)
  expiryAt       DateTime?
  expiryKind     ExpiryKind         @default(UNKNOWN)
  enabled        Boolean?
  dataSource     String             @default("unknown")
  syncState      SyncState          @default(NEVER)
  lastSyncAt     DateTime?
  lastSyncError  String?
  rawMetaJson    String?
  updatedAt      DateTime           @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model HmPanelConnection {
  id              String    @id @default(cuid())
  orgId           String    @unique
  baseUrl         String?
  credentialsEnc  String?
  configured      Boolean   @default(false)
  lastTestAt      DateTime?
  lastTestOk      Boolean?
  lastTestMessage String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String?
  userId     String?
  action     String
  resource   String?
  resourceId String?
  ip         String?
  metaJson   String?
  createdAt  DateTime @default(now())

  org  Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  user User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([action, createdAt])
}

model RenewalRequest {
  id             String        @id @default(cuid())
  orgId          String
  brandId        String
  subId          String
  /// AES-GCM encrypted subscription URL, used to re-resolve the account on approval
  subUrlEnc      String
  displayName    String?
  panelId        String?
  clientRef      String?
  planId         String
  planTitle      String
  days           Int
  gb             Float
  /// Allowed simultaneous users (0 = unchanged)
  users          Int           @default(0)
  /// add = extend time/data, reset = new period with usage zeroed
  mode           String        @default("add")
  price          String
  payerName      String?
  payerNote      String?
  receiptMime    String
  receiptData    Bytes
  /// renewal | purchase (a new service bought in the app)
  kind             String    @default("renewal")
  /// The receipt messages sent to each admin in Telegram (JSON), closed after the decision
  telegramMsgs     String?
  /// Copy sent to the HMPanel store bot (store/notify): {panelId, chatId, messageId}
  hmNotifyJson     String?
  /// Customer login of the buyer (purchases): the delivered service joins it
  customerId       String?
  /// Decided by the brand's timer, not a person
  autoDecided      Boolean   @default(false)
  autoTriedAt      DateTime?
  /// Purchases: the delivered subscription link (encrypted)
  resultUrlEnc     String?
  /// HMPanel store order when the brand renews through HMPanel
  externalOrderId  String?
  externalCode     String?
  externalSyncedAt DateTime?
  /// sha256 of the image, to catch the same receipt sent twice
  receiptHash    String?
  status         RenewalStatus @default(PENDING)
  adminNote      String?
  appliedOnPanel Boolean?
  applyMessage   String?
  deviceEndpoint String?
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime      @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  brand Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, status, createdAt])
  @@index([subId])
  @@index([brandId, receiptHash])
  @@index([status, externalOrderId])
}

model PushDevice {
  id        String   @id @default(cuid())
  brandId   String
  endpoint  String   @unique
  p256dh    String
  auth      String
  /// comma separated subIds this device follows
  subIds    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand   Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  follows PushFollow[]

  @@index([brandId])
}

/// A subscription a device follows, with its link so reminders can re-check it.
model PushFollow {
  id        String   @id @default(cuid())
  deviceId  String
  subId     String
  /// AES-GCM encrypted subscription URL
  urlEnc    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  device PushDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, subId])
  @@index([subId])
}

/// One reminder per account per threshold; cleared once the account is renewed.
model ExpiryReminder {
  id      String   @id @default(cuid())
  brandId String
  subId   String
  /// days | data
  kind    String
  sentAt  DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, subId, kind])
}

model LookupEvent {
  id        String   @id @default(cuid())
  brandId   String
  found     Boolean
  source    String
  createdAt DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// One reading of a subscription's total usage per (Tehran) day, taken on every
/// lookup and every reminder pass, so daily usage exists even when the app stays closed.
model UsageDay {
  id        String   @id @default(cuid())
  brandId   String
  subId     String
  day       String
  usedBytes BigInt
  updatedAt DateTime @updatedAt

  @@unique([brandId, subId, day])
  @@index([brandId, subId])
}

/// One phone/browser that opened a storefront (a random ID kept by the app).
model AppDevice {
  id         String   @id @default(cuid())
  brandId    String
  deviceId   String
  platform   String
  browser    String
  /// Opened as the installed app at least once
  standalone Boolean  @default(false)
  locale     String?
  opens      Int      @default(1)
  firstSeen  DateTime @default(now())
  lastSeen   DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, deviceId])
  @@index([brandId, firstSeen])
  @@index([brandId, lastSeen])
}

/// A subscription added on a device (once per device and subscription).
model AppSubscriptionAdd {
  id          String   @id @default(cuid())
  brandId     String
  deviceId    String
  subId       String
  displayName String?
  platform    String
  createdAt   DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, deviceId, subId])
  @@index([brandId, createdAt])
}

/// One web push send (reminder, renewal result or broadcast) and how it went.
model PushLog {
  id        String   @id @default(cuid())
  brandId   String
  /// reminder | renewal | broadcast | other
  kind      String
  subId     String?
  title     String
  body      String
  /// devices targeted
  total     Int      @default(0)
  /// accepted by the push service (Google / Apple / Mozilla)
  sent      Int      @default(0)
  /// shown on the phone (the service worker reports back)
  delivered Int      @default(0)
  /// tapped
  opened    Int      @default(0)
  /// device had unsubscribed; removed
  expired   Int      @default(0)
  failed    Int      @default(0)
  error     String?
  createdAt DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt])
}

/// A storefront customer's own login: username + password carrying their subscription links.
model CustomerAccount {
  id           String   @id @default(cuid())
  brandId      String
  username     String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  brand    Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  subs     CustomerSub[]
  sessions CustomerSession[]

  @@unique([brandId, username])
}

model CustomerSub {
  id        String   @id @default(cuid())
  accountId String
  subId     String
  urlEnc    String
  createdAt DateTime @default(now())

  account CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, subId])
}

model CustomerSession {
  id         String   @id @default(cuid())
  accountId  String
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  account CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}
