# Every brand domain gets a Let's Encrypt certificate automatically on its first
# visit. Caddy asks the API first, so only domains added in the admin panel
# (plus PRIMARY_DOMAIN) are ever issued certificates.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://api:4000/api/v1/public/domain-check
	}
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip

	handle /api/v1/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy web:3000
	}
}

# Plain HTTP redirects to HTTPS once a certificate exists.
http:// {
	redir https://{host}{uri} permanent
}
